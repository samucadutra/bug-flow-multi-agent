# BugFlow environment contract. Copy to `.env` (git-ignored) and adjust.
# Never commit real secrets. Values below are local demo placeholders.

# --- Database (backend) ---
DATABASE_URL=postgresql+psycopg://bugflow:bugflow@localhost:5432/bugflow
# Used only by integration tests; never point it at the main database.
TEST_DATABASE_URL=postgresql+psycopg://bugflow:bugflow@localhost:5432/bugflow_test

# --- OpenAI (backend) ---
# Leave empty here. Set your own key in `.env`.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
SIMILAR_BUGS_K=5

# --- API (backend) ---
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Docker Compose database service ---
POSTGRES_USER=bugflow
POSTGRES_PASSWORD=bugflow
POSTGRES_DB=bugflow
POSTGRES_PORT=5432

# --- Frontend (public by design) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
